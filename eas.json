{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tkchandradimuka-be.vercel.app/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tkchandradimuka-be.vercel.app/api"
      }
    }
  }
}
